{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-ninja",
      "displayName": "Windows MSVC Ninja Multi-Config",
      "description": "Configure with Ninja Multi-Config using the MSVC compiler environment.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/_build/",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "windows-msvc-ninja",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "windows-msvc-ninja",
      "configuration": "Release"
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "configurePreset": "windows-msvc-ninja",
      "configuration": "RelWithDebInfo"
    }
  ]
}
